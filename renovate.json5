{
  "extends": [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    "github>giantswarm/renovate-presets:default.json5",
    // The chart under helm/ is generated by `make sync`. Letting renovate edit
    // it directly produces PRs the next sync silently reverts -- the upstream
    // version is pinned once, in vendir.yml.
    "github>giantswarm/renovate-presets:disable-helmv3.json5",
    "github>giantswarm/renovate-presets:disable-helm-values.json5",
  ],
  "prBodyNotes": [
    "DO NOT merge this PR directly; you must check out the PR and run the sync script at `sync/sync.sh`.",
  ],
}
